# ResearchOS application settings
RESEARCHOS_PROJECT_NAME=ResearchOS
RESEARCHOS_ENVIRONMENT=development
RESEARCHOS_LOG_LEVEL=INFO

# API settings
RESEARCHOS_API_HOST=0.0.0.0
RESEARCHOS_API_PORT=8000

# Storage settings
RESEARCHOS_DATABASE_URL=sqlite:///./data/researchos.db
RESEARCHOS_CHROMA_PERSIST_DIRECTORY=./data/chroma
RESEARCHOS_GRAPHPAD_SCAN_FOLDERS=./data/graphpad,./samples/graphpad
RESEARCHOS_MICROSCOPY_SCAN_FOLDERS=./data/images,./samples/images

# Microsoft Graph delegated auth settings
# Register an Azure app before using these values for real login.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback
GRAPH_SCOPES=User.Read Notes.Read

# AI provider settings
# Set AI_PROVIDER=none to use search without chat generation.
# For OpenAI: set AI_PROVIDER=openai_compatible and AI_BASE_URL=https://api.openai.com/v1
# For OpenRouter: set AI_PROVIDER=openai_compatible and AI_BASE_URL=https://openrouter.ai/api/v1
# For Ollama: set AI_PROVIDER=openai_compatible and AI_BASE_URL=http://localhost:11434/v1
# For LM Studio: set AI_PROVIDER=openai_compatible and AI_BASE_URL=http://localhost:1234/v1
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
